    "import pandas as pd\n",
    "import glob\n",
    "import os\n",
    "\n",
    "cgm_5files_mv = glob.glob(\"C:/python_hackathon/HUPA-UC Diabetes Dataset-20250820T010637Z-1-001/HUPA-UC Diabetes Dataset/CGM5_MV/*.csv\")\n",
    "\n",
    "dfs = []\n",
    "for file in cgm_5files_mv :\n",
    "    if os.path.isfile(file):\n",
    "        df = pd.read_csv(file, sep=';')\n",
    "        df['patient_id'] = os.path.basename(file).replace('.csv', '')\n",
    "        dfs.append(df)\n",
    "\n",
    "\n",
    "df_CGM5_MV= pd.concat(dfs, ignore_index=True)\n",
    "\n",
    "# Move patient_id to first column\n",
    "cols = ['patient_id'] + [col for col in df_CGM5_MV.columns if col != 'patient_id']\n",
    "df_CGM5_MV = df_CGM5_MV[cols]\n",
    "\n",
    "df_CGM5_MV"
